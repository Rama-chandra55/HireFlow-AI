      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "jsCode": "const roles=$input.all().map(i=>i.json).filter(r=>r.Role).map(r=>({role:r.Role,mustHaves:r['Must Haves']||'',niceToHaves:r['Nice to Haves']||'',notes:r.Notes||''})); return [{json:{ok:true,roles}}];"
      }
