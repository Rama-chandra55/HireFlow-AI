    {
      "name": "Normalize Status Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        640
      ],
      "parameters": {
        "jsCode": "const q=$input.first().json.query||{}; const AIRTABLE_BASE_ID=String(q.AIRTABLE_BASE_ID||'').trim().replace(/[^A-Za-z0-9_-]/g,''); const email=String(q.email||'').trim().toLowerCase(); const safeEmail=email.replace(/'/g,'’'); const valid=!!AIRTABLE_BASE_ID&&/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email); return [{json:{application_id:AIRTABLE_BASE_ID,email,valid,filter:`AND({Application ID}='${AIRTABLE_BASE_ID}',LOWER({Email})=LOWER('${safeEmail}'))`}}];"
      }
    },
    {
      "name": "Status Lookup Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        640
      ],
