          "mode": "id",
          "value": "AIRTABLE_TABLE_ID"
        },
        "filterByFormula": "={{ $('Normalize Status Lookup').item.json.filter }}",
        "options": {}
      }
    },
    {
      "name": "Status Candidate Found?",
