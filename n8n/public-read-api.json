      ],
      "parameters": {
        "jsCode": "const d=$input.first().json; return [{json:{ok:true,application:{AIRTABLE_BASE_ID:d['Application ID'],name:d.Name,role:d.Role,stage:d.Stage,appliedAt:d['Applied At ']||null,interviewStart:d['Interview Start']||null,interviewEnd:d['Interview End ']||null}}}];"
      }
    },
