    {
      "name": "Shape Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const parse=(v,f)=>{try{return v?JSON.parse(v):f}catch{return f}}; const candidates=$input.all().map(i=>i.json).filter(d=>d['Application ID']).map(d=>({AIRTABLE_BASE_ID:d['Application ID'],name:d.Name||'',email:d.Email||'',role:d.Role||'',stage:d.Stage||'Received',source:d.Source||'',appliedAt:d['Applied At ']||null,parseQuality:d['Parse Quality']||null,aiSummary:d['AI Summary']||'',matchedRequirements:parse(d['Requirements Found'],[]),missingRequirements:parse(d['Missing Requirements'],[]),evidence:parse(String(d['Evidence ']||'').replace(/^=/,''),{}),confidence:String(d['Confidence ']||'').replace(/^=/,''),AIRTABLE_RECORD_ID:d['Recruiter Notes ']||'',interviewStart:d['Interview Start']||null,interviewEnd:d['Interview End ']||null,decisionRequired:d.Stage==='Awaiting Recruiter Review'||String(d.Stage||'').startsWith('Needs Manual Review')})); candidates.sort((a,b)=>String(b.appliedAt||'').localeCompare(String(a.appliedAt||''))); return [{json:{ok:true,candidates,count:candidates.length}}];"
      }
    },
