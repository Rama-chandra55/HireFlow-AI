    {
      "name": "Calculate Recruiter Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json).filter(d=>d['Application ID']); const byRole={}; let awaitingReview=0,advanced=0,rejected=0,manualReview=0,received=0; for(const d of rows){const s=String(d.Stage||'Received'); const r=d.Role||'Unspecified'; byRole[r]=(byRole[r]||0)+1; if(s==='Awaiting Recruiter Review') awaitingReview++; else if(s.startsWith('Advanced')) advanced++; else if(s.startsWith('Rejected')) rejected++; else if(s.startsWith('Needs Manual Review')) manualReview++; else received++;} return [{json:{ok:true,stats:{total:rows.length,awaitingReview,manualReview,advanced,rejected,received,byRole}}}];"
      }
    },
