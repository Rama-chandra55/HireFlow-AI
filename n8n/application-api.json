    {
      "name": "Normalize & Validate Application",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3200,
        544
      ],
      "parameters": {
        "jsCode": "const req=$input.first().json;\nconst d=req.body||req;\n\nconst name=String(d.name||'').trim();\nconst email=String(d.email||'').trim().toLowerCase();\nconst rawRole=String(d.role||'').trim();\nconst role=rawRole?rawRole.toLowerCase().replace(/\\b\\w/g,c=>c.toUpperCase()):'';\n\nconst fileName=String(d.resumeFileName||'resume.pdf').trim();\nconst mime=String(d.resumeMimeType||'application/pdf').trim().toLowerCase();\nconst storageKey=String(d.resumeStorageKey||'').trim();\nconst resumeSizeBytes=Number(d.resumeSizeBytes||0);\nconst resumeText=String(d.resumeText||'')\n  .replace(/\\u0000/g,'')\n  .replace(/[ \\t]+\\n/g,'\\n')\n  .replace(/\\n{3,}/g,'\\n\\n')\n  .trim();\n\nconst errors=[];\nif(name.length<2) errors.push('Name is required.');\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('A valid email is required.');\nif(!role) errors.push('Role is required.');\nif(!resumeText) errors.push('Resume text is required.');\nif(resumeText.length>150000) errors.push('Resume text is unexpectedly large.');\nif(mime!=='application/pdf'&&!fileName.toLowerCase().endsWith('.pdf')) errors.push('Resume must be a PDF.');\nif(Number.isFinite(resumeSizeBytes)&&resumeSizeBytes>5*1024*1024) errors.push('Resume must be 5 MB or smaller.');\n\nconst AIRTABLE_BASE_ID=`HF-${Date.now()}-${Math.random().toString(36).slice(2,7).toUpperCase()}`;\nconst safe=s=>String(s).replace(/'/g,'’');\n\nreturn [{\n  json:{\n    application_id:AIRTABLE_BASE_ID,\n    name,\n    email,\n    role,\n    applied_at:new Date().toISOString(),\n    valid_input:errors.length===0,\n    validation_error:errors.join(' '),\n    duplicate_filter:`AND(LOWER({Email})=LOWER('${safe(email)}'),LOWER({Role})=LOWER('${safe(role)}'))`,\n    role_filter:`LOWER({Role})=LOWER('${safe(role)}')`,\n    resume_file_name:fileName||'resume.pdf',\n    resume_mime_type:mime||'application/pdf',\n    resume_storage_key:storageKey,\n    resume_size_bytes:Number.isFinite(resumeSizeBytes)?resumeSizeBytes:0,\n    resume_text:resumeText\n  }\n}];"
      }
    },
