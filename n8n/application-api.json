    {
      "name": "Prepare Resume + Rubric",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        112
      ],
      "parameters": {
        "jsCode": "let text=$('Evaluate Parse Quality').item.json.text||'';\ntext=text.replace(/[\\u200B-\\u200D\\uFEFF]/g,'').replace(/\\s+/g,' ').trim();\nif(text.length>15000) text=text.slice(0,15000);\n\nconst r=$input.first().json;\nconst rubric={\n  role:r.Role||$('Normalize & Validate Application').item.json.role,\n  must_haves:r['Must Haves']||'',\n  nice_to_haves:r['Nice to Haves']||'',\n  notes:r.Notes||''\n};\n\nconst prompt = [\n  'You are an evidence-extraction assistant supporting a HUMAN recruiter. You do not make hiring decisions and you do not rank candidates.',\n  '',\n  'Compare the resume only against the role rubric. Ignore and do not infer protected or sensitive attributes including age, sex, gender, race, religion, disability, marital status, nationality, caste, sexual orientation, health information, or similar attributes.',\n  '',\n  'Use only evidence explicitly present in the resume. If evidence is missing, say it is missing or unclear; do not invent it.',\n  '',\n  'JOB RUBRIC:',\n  JSON.stringify(rubric),\n  '',\n  'RESUME:',\n  text,\n  '',\n  'Return ONLY valid JSON with exactly these keys:',\n  '{',\n  '\"role\":\"string\",',\n  '\"matched_requirements\":[{\"requirement\":\"string\",\"evidence\":\"concise resume evidence\"}],',\n  '\"missing_or_unclear_requirements\":[\"string\"],',\n  '\"relevant_experience\":[\"string\"],',\n  '\"relevant_projects\":[\"string\"],',\n  '\"education_summary\":\"string\",',\n  '\"skills\":[\"string\"],',\n  '\"concise_summary\":\"2-4 sentences for recruiter review\",',\n  '\"confidence\":\"low|medium|high\"',\n  '}',\n  '',\n  'The confidence field means confidence in the evidence extraction, not candidate quality or suitability. Do not output a hire/reject decision or candidate score. Do not include markdown fences.'\n].join('\\n');\n\nreturn [{\n  json:{\n    resume_text:text,\n    rubric,\n    gemini_request:{\n      contents:[{\n        role:'user',\n        parts:[{text:prompt}]\n      }],\n      generationConfig:{\n        temperature:0.2,\n        maxOutputTokens:2048,\n        responseMimeType:'application/json',\n        thinkingConfig:{thinkingBudget:0}\n      }\n    }\n  }\n}];"
      }
    },
    {
      "name": "Validate AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        112
      ],
      "parameters": {
        "jsCode": "const input=$input.first().json;\nlet raw =\n  input.text ??\n  input.output ??\n  input.candidates?.[0]?.content?.parts?.map(p=>p?.text||'').join('') ??\n  '';\n\nif(typeof raw!=='string') raw=JSON.stringify(raw);\nraw=raw.replace(/```json|```/g,'').trim();\n\nlet p;\ntry{\n  p=JSON.parse(raw);\n}catch(e){\n  return [{\n    json:{\n      valid:false,\n      concise_summary:'AI output could not be validated. Human review required.',\n      confidence:'low',\n      raw_output:raw.slice(0,3000)\n    }\n  }];\n}\n\nconst required=['matched_requirements','missing_or_unclear_requirements','concise_summary','confidence'];\nconst valid=required.every(k=>Object.prototype.hasOwnProperty.call(p,k));\n\nreturn [{\n  json:{\n    ...p,\n    valid,\n    matched_requirements:Array.isArray(p.matched_requirements)?p.matched_requirements:[],\n    missing_or_unclear_requirements:Array.isArray(p.missing_or_unclear_requirements)?p.missing_or_unclear_requirements:[],\n    relevant_experience:Array.isArray(p.relevant_experience)?p.relevant_experience:[],\n    relevant_projects:Array.isArray(p.relevant_projects)?p.relevant_projects:[],\n    skills:Array.isArray(p.skills)?p.skills:[],\n    confidence:['low','medium','high'].includes(p.confidence)?p.confidence:'low'\n  }\n}];"
      }
    },
