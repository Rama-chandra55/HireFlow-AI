      "parameters": {
        "sendTo": "recruiter@example.com",
        "subject": "HireFlow AI — Candidate ready for human review",
        "message": "=<div style=\"font-family:Arial,sans-serif;line-height:1.6\"><h2>Candidate Ready for Human Review</h2><p><strong>Candidate:</strong> {{ $(\"Normalize & Validate Application\").item.json.name }}</p><p><strong>Email:</strong> {{ $(\"Normalize & Validate Application\").item.json.email }}</p><p><strong>Role:</strong> {{ $(\"Normalize & Validate Application\").item.json.role }}</p><p><strong>Application ID:</strong> {{ $(\"Normalize & Validate Application\").item.json.application_id }}</p><hr><h3>AI Evidence Summary</h3><p>{{ $(\"Validate AI Output\").item.json.concise_summary }}</p><h3>Matched Requirements</h3><ul>{{ ($(\"Validate AI Output\").item.json.matched_requirements||[]).map(item=>`<li><strong>${item.requirement}</strong>: ${item.evidence}</li>`).join(\"\") }}</ul><h3>Missing / Unclear Requirements</h3><ul>{{ ($(\"Validate AI Output\").item.json.missing_or_unclear_requirements||[]).map(item=>`<li>${item}</li>`).join(\"\") }}</ul><p><strong>Extraction confidence:</strong> {{ $(\"Validate AI Output\").item.json.confidence }}</p><hr><p><strong>Human review required.</strong> AI has only organized resume evidence and has not made the hiring decision.</p><p>Regards,<br><strong>HireFlow AI</strong></p></div>",
