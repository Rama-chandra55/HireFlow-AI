    {
      "name": "Evaluate Parse Quality",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1568,
        352
      ],
      "parameters": {
        "jsCode": "const source=$('Normalize & Validate Application').item.json;\nconst text=String(source.resume_text||'').replace(/\\s+/g,' ').trim();\nconst wordCount=text?text.split(/\\s+/).length:0;\nconst charCount=text.length;\nconst poor=wordCount<80||charCount<500;\n\nreturn [{\n  json:{\n    ...$input.first().json,\n    text,\n    parse_quality:poor?'poor':'good',\n    word_count:wordCount,\n    char_count:charCount\n  }\n}];"
      }
    },
